# Configuración del Servidor
PUERTO=3000
NODE_ENV=desarrollo

# Enlace de conexión a Supabase (PostgreSQL Connection String)
BD_URL=postgresql://postgres.tu_id_proyecto:tu_contraseña@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Autenticación JWT
JWT_SECRETO=clave_secreta_super_segura_subastas
JWT_EXPIRACION=24h

# Configuración de Subastas
TIEMPO_INACTIVIDAD_MINUTOS=5

# Configuración de Correo Gmail (SMTP)
CORREO_SERVICIO=gmail
CORREO_HOST=smtp.gmail.com
CORREO_PUERTO=465
CORREO_USUARIO=tu_correo@gmail.com
CORREO_CLAVE=tu_contrasena_de_aplicacion_gmail
CORREO_REMITENTE="SubastasPro <tu_correo@gmail.com>"

# Cloudinary (Almacenamiento de imágenes en la nube)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

