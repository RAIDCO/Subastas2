//- Overlay oscuro para cerrar sidebar en móvil
div(id="sidebar-overlay" class="fixed inset-0 bg-black/30 z-40 hidden lg:hidden backdrop-blur-sm")

//- Sidebar principal
aside(id="sidebar" class="fixed lg:static inset-y-0 left-0 z-50 w-64 bg-white border-r border-[#E2DDD5] flex flex-col transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out")

  //- Logo y cabecera del sidebar
  div(class="flex items-center justify-between h-16 px-5 border-b border-[#E2DDD5]")
    a(href="/subastas" class="flex items-center gap-2.5 group")
      div(class="w-8 h-8 rounded-lg bg-[#D97706] flex items-center justify-center group-hover:scale-105 transition-transform")
        svg(class="w-4.5 h-4.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2")
          path(stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z")
      span(class="font-bold text-lg text-[#1A1614]") Subastas
        span(class="text-[#C2410C]") Pro

    //- Botón cerrar sidebar (solo móvil)
    button(id="sidebar-close" class="lg:hidden text-[#8A7F76] hover:text-[#1A1614] transition-colors")
      svg(class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24")
        path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12")

  //- Enlaces de navegación
  nav(class="flex-1 px-3 py-4 space-y-1 overflow-y-auto")

    //- Subastas Activas
    a(href="/subastas" class=`flex items-center gap-3 px-3 py-2.5 rounded-[10px] text-sm font-medium transition-all relative ${paginaActual === 'subastas' ? 'bg-[#FFFBEB] text-[#D97706] border-l-[3px] border-[#D97706] pl-[9px]' : 'text-[#3D3530] hover:bg-[#EFECE6] hover:text-[#1A1614]'}`)
      svg(class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75")
        path(stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10")
      span Subastas Activas

    //- Publicar Subasta
    a(href="/crear-subasta" class=`flex items-center gap-3 px-3 py-2.5 rounded-[10px] text-sm font-medium transition-all relative ${paginaActual === 'crear-subasta' ? 'bg-[#FFFBEB] text-[#D97706] border-l-[3px] border-[#D97706] pl-[9px]' : 'text-[#3D3530] hover:bg-[#EFECE6] hover:text-[#1A1614]'}`)
      svg(class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75")
        path(stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4")
      span Publicar Subasta

    //- Mi Historial
    a(href="/historial" class=`flex items-center gap-3 px-3 py-2.5 rounded-[10px] text-sm font-medium transition-all relative ${paginaActual === 'historial' ? 'bg-[#FFFBEB] text-[#D97706] border-l-[3px] border-[#D97706] pl-[9px]' : 'text-[#3D3530] hover:bg-[#EFECE6] hover:text-[#1A1614]'}`)
      svg(class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75")
        path(stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01")
      span Mi Historial

    //- Mis Favoritos
    a(href="/favoritos" class=`flex items-center gap-3 px-3 py-2.5 rounded-[10px] text-sm font-medium transition-all relative ${paginaActual === 'favoritos' ? 'bg-[#FFFBEB] text-[#D97706] border-l-[3px] border-[#D97706] pl-[9px]' : 'text-[#3D3530] hover:bg-[#EFECE6] hover:text-[#1A1614]'}`)
      svg(class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75")
        path(stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z")
      span Mis Favoritos

    //- Panel Admin (solo visible para administradores)
    if usuario && usuario.rol === 'administrador'
      a(href="/admin" class=`flex items-center gap-3 px-3 py-2.5 rounded-[10px] text-sm font-medium transition-all relative ${paginaActual === 'admin' ? 'bg-[#FFFBEB] text-[#D97706] border-l-[3px] border-[#D97706] pl-[9px]' : 'text-[#3D3530] hover:bg-[#EFECE6] hover:text-[#1A1614]'}`)
        svg(class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75")
          path(stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z")
        span Panel Admin

    //- Separador
    div(class="my-4 border-t border-[#E2DDD5]")

    //- Mi Perfil
    a(href="/perfil" class=`flex items-center gap-3 px-3 py-2.5 rounded-[10px] text-sm font-medium transition-all relative ${paginaActual === 'perfil' ? 'bg-[#FFFBEB] text-[#D97706] border-l-[3px] border-[#D97706] pl-[9px]' : 'text-[#3D3530] hover:bg-[#EFECE6] hover:text-[#1A1614]'}`)
      svg(class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75")
        path(stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z")
      span Mi Perfil

  //- Footer del sidebar con info de usuario
  div(class="px-4 py-4 border-t border-[#E2DDD5]")
    div(class="flex items-center gap-3")
      div(class="w-9 h-9 rounded-full bg-[#FFF7ED] border border-[#FFEDD5] flex items-center justify-center")
        span(class="text-[#C2410C] font-semibold text-sm")= usuario ? usuario.nombre.charAt(0).toUpperCase() : 'U'
      div(class="flex-1 min-w-0")
        p(class="text-sm font-medium text-[#1A1614] truncate")= usuario ? usuario.nombre : 'Usuario'
        p(class="text-xs text-[#8A7F76] truncate")= usuario ? usuario.correo : 'correo@ejemplo.com'
