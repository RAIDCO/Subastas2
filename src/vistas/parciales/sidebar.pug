//- Overlay oscuro para cerrar sidebar en móvil
div(id="sidebar-overlay" class="fixed inset-0 bg-black/60 z-40 hidden lg:hidden")

//- Sidebar principal
aside(id="sidebar" class="fixed lg:static inset-y-0 left-0 z-50 w-64 bg-slate-900 border-r border-slate-800 flex flex-col transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out")

  //- Logo y cabecera del sidebar
  div(class="flex items-center justify-between h-16 px-5 border-b border-slate-800")
    a(href="/subastas" class="flex items-center gap-2.5 group")
      div(class="w-8 h-8 rounded-lg bg-emerald-500 flex items-center justify-center group-hover:scale-105 transition-transform")
        svg(class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24")
          path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z")
      span(class="font-bold text-lg text-white") Subastas
        span(class="text-emerald-400") Pro

    //- Botón cerrar sidebar (solo móvil)
    button(id="sidebar-close" class="lg:hidden text-slate-400 hover:text-white")
      svg(class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24")
        path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12")

  //- Enlaces de navegación
  nav(class="flex-1 px-3 py-4 space-y-1 overflow-y-auto")

    //- Subastas Activas
    a(href="/subastas" class=`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors ${paginaActual === 'subastas' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : 'text-slate-300 hover:bg-slate-800 hover:text-white'}`)
      svg(class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24")
        path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10")
      span Subastas Activas

    //- Publicar Subasta
    a(href="/crear-subasta" class=`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors ${paginaActual === 'crear-subasta' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : 'text-slate-300 hover:bg-slate-800 hover:text-white'}`)
      svg(class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24")
        path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4")
      span Publicar Subasta

    //- Mi Historial
    a(href="/historial" class=`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors ${paginaActual === 'historial' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : 'text-slate-300 hover:bg-slate-800 hover:text-white'}`)
      svg(class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24")
        path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01")
      span Mi Historial

    //- Separador
    div(class="my-4 border-t border-slate-800")

    //- Mi Perfil
    a(href="/perfil" class=`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors ${paginaActual === 'perfil' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : 'text-slate-300 hover:bg-slate-800 hover:text-white'}`)
      svg(class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24")
        path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z")
      span Mi Perfil

  //- Footer del sidebar con info de usuario
  div(class="px-4 py-4 border-t border-slate-800")
    div(class="flex items-center gap-3")
      div(class="w-9 h-9 rounded-full bg-emerald-500/20 border border-emerald-500/30 flex items-center justify-center")
        span(class="text-emerald-400 font-semibold text-sm")= usuario ? usuario.nombre.charAt(0).toUpperCase() : 'U'
      div(class="flex-1 min-w-0")
        p(class="text-sm font-medium text-white truncate")= usuario ? usuario.nombre : 'Usuario'
        p(class="text-xs text-slate-400 truncate")= usuario ? usuario.correo : 'correo@ejemplo.com'
