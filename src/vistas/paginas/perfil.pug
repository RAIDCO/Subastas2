extends ../disenos/autenticado.pug

block contenido

  h1(class="text-2xl font-bold text-[#1A1614] mb-8 anim-fade-up") Mi Perfil

  //- Alerta de resultado (se muestra/oculta con JS al guardar cambios)
  div(id="alerta-error" class="hidden mb-6 bg-[#FEF2F2] border border-[#FECACA] text-[#991B1B] text-sm p-4 rounded-xl flex items-center gap-2")
    svg(class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24")
      path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z")
    span(id="mensaje-error")

  div(id="alerta-exito" class="hidden mb-6 bg-[#ECFDF5] border border-[#A7F3D0] text-[#065F46] text-sm p-4 rounded-xl flex items-center gap-2")
    svg(class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24")
      path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7")
    span(id="mensaje-exito") Perfil actualizado correctamente.

  div(class="grid grid-cols-1 md:grid-cols-3 gap-8")

    //- Tarjeta principal con la información del usuario
    div(class="md:col-span-1")
      div(class="bg-white border border-[#E2DDD5] rounded-[16px] p-6 text-center shadow-card anim-fade-up anim-fade-up-1")

        //- Avatar con la inicial del usuario
        div(class="mx-auto w-24 h-24 rounded-full bg-[#FFFBEB] border-2 border-[#FDE68A] flex items-center justify-center text-3xl font-bold text-[#D97706] mb-4")
          span= usuario ? usuario.nombre.charAt(0).toUpperCase() : 'U'

        h2(class="text-xl font-semibold text-[#1A1614]")= usuario ? usuario.nombre : 'Nombre del usuario'
        p(class="text-[#8A7F76] text-sm mt-1")= usuario ? usuario.correo : 'correo@ejemplo.com'

        span(class=`inline-block mt-4 px-3 py-1 rounded-full text-xs font-semibold ${usuario && usuario.rol === 'administrador' ? 'bg-[#FFFBEB] text-[#D97706] border border-[#FDE68A]' : 'bg-[#EFECE6] text-[#3D3530] border border-[#E2DDD5]'}`)
          = usuario && usuario.rol === 'administrador' ? 'Administrador' : 'Usuario'

    //- Formulario de edición de datos
    div(class="md:col-span-2")
      div(class="bg-white border border-[#E2DDD5] rounded-[16px] p-6 shadow-card anim-fade-up anim-fade-up-2")

        h3(class="text-lg font-semibold text-[#1A1614] mb-6") Configuración de la cuenta

        form(id="form-perfil" class="space-y-5" novalidate)

          div
            label(class="block text-[#1A1614] mb-2 text-sm font-medium") Nuevo nombre
            input(
              type="text"
              id="nuevoNombre"
              name="nombre"
              placeholder="Escribe tu nuevo nombre"
              value=usuario ? usuario.nombre : ''
              class="w-full bg-[#EFECE6] border border-[#E2DDD5] rounded-[10px] p-3 text-[#1A1614] placeholder-[#ADA69E] focus:outline-none focus:border-[#D97706] focus:ring-2 focus:ring-[#FDE68A] transition-all"
            )
            span(id="error-nombre" class="hidden text-[#DC2626] text-xs mt-1 block")

          div
            label(class="block text-[#1A1614] mb-2 text-sm font-medium") Nueva contraseña (opcional)
            input(
              type="password"
              id="nuevaClave"
              name="clave"
              placeholder="Déjalo en blanco para no cambiarla"
              class="w-full bg-[#EFECE6] border border-[#E2DDD5] rounded-[10px] p-3 text-[#1A1614] placeholder-[#ADA69E] focus:outline-none focus:border-[#D97706] focus:ring-2 focus:ring-[#FDE68A] transition-all"
            )
            span(id="error-clave" class="hidden text-[#DC2626] text-xs mt-1 block")
            p(class="text-[#ADA69E] text-xs mt-1") Mínimo 8 caracteres si deseas cambiarla.

          button(
            type="submit"
            id="btn-guardar"
            class="bg-[#D97706] hover:bg-[#B45309] text-white font-semibold py-3 px-6 rounded-[10px] transition-colors shadow-btn"
          ) Guardar Cambios

block scripts
  script.
    const formulario = document.getElementById('form-perfil');
    const alertaError = document.getElementById('alerta-error');
    const mensajeError = document.getElementById('mensaje-error');
    const alertaExito = document.getElementById('alerta-exito');
    const btnGuardar = document.getElementById('btn-guardar');

    // ── Utilidades de validación inline ──
    function mostrarErrorCampo(inputId, errorId, mensaje) {
      const input = document.getElementById(inputId);
      const errorSpan = document.getElementById(errorId);
      if (input) {
        input.classList.add('border-[#DC2626]');
        input.classList.remove('border-[#E2DDD5]');
      }
      if (errorSpan) {
        errorSpan.textContent = mensaje;
        errorSpan.classList.remove('hidden');
      }
    }

    function limpiarErrorCampo(inputId, errorId) {
      const input = document.getElementById(inputId);
      const errorSpan = document.getElementById(errorId);
      if (input) {
        input.classList.remove('border-[#DC2626]');
        input.classList.add('border-[#E2DDD5]');
      }
      if (errorSpan) {
        errorSpan.textContent = '';
        errorSpan.classList.add('hidden');
      }
    }

    // ── Validaciones de campos ──
    function validarNombrePerfil() {
      const valor = document.getElementById('nuevoNombre').value.trim();
      if (!valor) {
        mostrarErrorCampo('nuevoNombre', 'error-nombre', 'El nombre es obligatorio.');
        return false;
      }
      if (valor.length < 3) {
        mostrarErrorCampo('nuevoNombre', 'error-nombre', 'El nombre debe tener al menos 3 caracteres. Actualmente tiene ' + valor.length + '.');
        return false;
      }
      if (valor.length > 120) {
        mostrarErrorCampo('nuevoNombre', 'error-nombre', 'El nombre no puede superar los 120 caracteres.');
        return false;
      }
      limpiarErrorCampo('nuevoNombre', 'error-nombre');
      return true;
    }

    function validarClavePerfil() {
      const valor = document.getElementById('nuevaClave').value;
      // La contraseña es opcional en el perfil: solo validar si el usuario escribió algo
      if (!valor || valor.trim() === '') {
        limpiarErrorCampo('nuevaClave', 'error-clave');
        return true;
      }
      if (valor.length < 8) {
        mostrarErrorCampo('nuevaClave', 'error-clave', 'La contraseña debe tener al menos 8 caracteres. Actualmente tiene ' + valor.length + '.');
        return false;
      }
      limpiarErrorCampo('nuevaClave', 'error-clave');
      return true;
    }

    function validarFormPerfil() {
      const resultados = [
        validarNombrePerfil(),
        validarClavePerfil()
      ];
      return resultados.every(r => r === true);
    }

    // Blur validation — real-time feedback
    document.getElementById('nuevoNombre').addEventListener('blur', validarNombrePerfil);
    document.getElementById('nuevaClave').addEventListener('blur', validarClavePerfil);

    formulario.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      alertaError.classList.add('hidden');
      alertaExito.classList.add('hidden');

      if (!validarFormPerfil()) {
        mensajeError.textContent = 'Por favor corrige los errores señalados en el formulario.';
        alertaError.classList.remove('hidden');
        return;
      }

      const nombre = document.getElementById('nuevoNombre').value.trim();
      const clave = document.getElementById('nuevaClave').value.trim();

      const cuerpo = {};
      if (nombre) cuerpo.nombre = nombre;
      if (clave) cuerpo.clave = clave;

      btnGuardar.disabled = true;
      btnGuardar.textContent = 'Guardando...';

      try {
        const token = localStorage.getItem('token');

        const respuesta = await fetch('/api/usuario/perfil', {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
            ...(token ? { Authorization: 'Bearer ' + token } : {})
          },
          credentials: 'include',
          body: JSON.stringify(cuerpo)
        });

        const datos = await respuesta.json();

        if (datos.exito) {
          alertaExito.classList.remove('hidden');
          document.getElementById('nuevaClave').value = '';
          limpiarErrorCampo('nuevaClave', 'error-clave');
        } else {
          mensajeError.textContent = datos.mensaje || 'No se pudo actualizar el perfil.';
          alertaError.classList.remove('hidden');
        }
      } catch (error) {
        mensajeError.textContent = 'Error de conexión con el servidor.';
        alertaError.classList.remove('hidden');
      } finally {
        btnGuardar.disabled = false;
        btnGuardar.textContent = 'Guardar Cambios';
      }
    });
