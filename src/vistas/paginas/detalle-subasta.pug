extends ../disenos/autenticado.pug

block contenido
  -
    const formatearMonto = (valor) => {
      if (valor === null || valor === undefined) return '—';
      return '$' + Number(valor).toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    };
    const formatearFecha = (valor) => {
      if (!valor) return '—';
      return new Date(valor).toLocaleString('es-MX', { timeZone: 'America/Mexico_City', day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
    };
    const estilosEstado = {
      pendiente: 'bg-[#FFFBEB] text-[#92400E] border-[#FDE68A]',
      programada: 'bg-purple-50 text-purple-700 border-purple-200',
      activa: 'bg-[#ECFDF5] text-[#065F46] border-[#A7F3D0]',
      finalizada: 'bg-[#EFECE6] text-[#8A7F76] border-[#E2DDD5]',
      rechazada: 'bg-[#FEF2F2] text-[#991B1B] border-[#FECACA]'
    };
    const estadoMostrar = subasta ? (subasta.estadoEfectivo || subasta.estado) : 'pendiente';
    const todasImagenes = subasta ? [subasta.imagen_url, ...(subasta.imagenes_urls || [])].filter(Boolean) : [];

  if !subasta
    div(class="text-center py-20 anim-fade-up")
      h2(class="text-2xl font-bold text-[#1A1614] mb-2") Subasta no encontrada
      p(class="text-[#8A7F76]") La subasta que buscas no existe o fue eliminada.
      a(href="/subastas" class="inline-block mt-6 bg-[#D97706] hover:bg-[#B45309] text-white font-semibold px-6 py-3 rounded-[10px] transition-colors shadow-btn") Volver al catálogo

  else
    //- Header con título, botón de favoritos y estado
    div(class="mb-6 anim-fade-up")
      div(class="flex items-center justify-between gap-3 mb-2")
        a(href="/subastas" class="text-[#8A7F76] hover:text-[#1A1614] transition-colors flex items-center gap-1 text-sm")
          svg(class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7")
          span Volver al catálogo

        //- Botón Favorito (Bookmark / Heart)
        button(
          type="button"
          id="btn-fav-detalle"
          data-subasta-id=subasta.id
          class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-white border border-[#E2DDD5] text-xs font-semibold text-[#8A7F76] hover:border-[#FECACA] hover:bg-[#FEF2F2] hover:text-[#DC2626] transition-all shadow-sm"
        )
          svg(class="w-4 h-4 icono-corazon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2")
            path(stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z")
          span Guardar en Favoritos

      div(class="flex flex-wrap items-center justify-between gap-4")
        div
          h1(class="text-2xl lg:text-3xl font-bold text-[#1A1614]")= subasta.titulo
          div(class="flex flex-wrap items-center gap-3 mt-2")
            span(class=`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold border ${estilosEstado[estadoMostrar]}`)
              if estadoMostrar === 'activa'
                span(class="w-1.5 h-1.5 rounded-full bg-[#059669] dot-live")
              else if estadoMostrar === 'programada'
                span(class="w-1.5 h-1.5 rounded-full bg-purple-500 dot-live")
              span= estadoMostrar.toUpperCase()
            if subasta.categoria
              span(class="bg-[#EFECE6] text-[#3D3530] text-xs font-medium px-2.5 py-1 rounded-full border border-[#E2DDD5]")= subasta.categoria.nombre
            if subasta.vendedor
              span(class="text-[#8A7F76] text-sm") Publicado por
                span(class="text-[#1A1614] font-medium ml-1")= subasta.vendedor.nombre

    //- Layout principal: 2 columnas
    div(class="grid grid-cols-1 lg:grid-cols-3 gap-6")

      //- Columna izquierda (lg:col-span-2): Galería de imágenes + Descripción + Detalles
      div(class="lg:col-span-2 space-y-6")

        //- Galería de imágenes con visor principal + miniaturas
        div(class="bg-white border border-[#E2DDD5] rounded-[16px] overflow-hidden shadow-card p-4 anim-fade-up anim-fade-up-1")
          if todasImagenes.length > 0
            div(class="relative h-72 lg:h-96 rounded-xl overflow-hidden bg-[#EFECE6] mb-3")
              img(id="imagen-principal" src=todasImagenes[0] alt=subasta.titulo class="w-full h-full object-cover transition-all duration-300")

            if todasImagenes.length > 1
              div(class="flex items-center gap-2 overflow-x-auto pb-1")
                each imgUrl, idx in todasImagenes
                  button(
                    type="button"
                    onclick=`document.getElementById('imagen-principal').src='${imgUrl}'`
                    class=`w-16 h-16 rounded-lg overflow-hidden border-2 flex-shrink-0 transition-all ${idx === 0 ? 'border-[#D97706]' : 'border-[#E2DDD5] hover:border-[#D97706]'}`
                  )
                    img(src=imgUrl alt="Miniatura" class="w-full h-full object-cover")
          else
            div(class="w-full h-72 lg:h-96 bg-[#EFECE6] rounded-xl flex items-center justify-center")
              svg(class="w-16 h-16 text-[#E2DDD5]" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z")

        //- Descripción
        div(class="bg-white border border-[#E2DDD5] rounded-[16px] p-6 shadow-card anim-fade-up anim-fade-up-2")
          h3(class="text-lg font-bold text-[#1A1614] mb-3") Descripción
          p(class="text-[#3D3530] leading-relaxed whitespace-pre-line")= subasta.descripcion

        //- Información de la subasta
        div(class="bg-white border border-[#E2DDD5] rounded-[16px] p-6 shadow-card anim-fade-up anim-fade-up-3")
          h3(class="text-lg font-bold text-[#1A1614] mb-4") Detalles de la subasta
          div(class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-sm")
            div
              p(class="text-[#8A7F76] text-xs uppercase tracking-wide mb-1") Precio Inicial
              p(class="text-[#1A1614] font-semibold")= formatearMonto(subasta.precio_inicial)
            div
              p(class="text-[#8A7F76] text-xs uppercase tracking-wide mb-1") Inactividad
              p(class="text-[#1A1614] font-semibold") #{subasta.tiempo_inactividad_minutos} min
            div
              p(class="text-[#8A7F76] text-xs uppercase tracking-wide mb-1") Publicación
              p(class="text-[#1A1614] font-semibold text-xs")= formatearFecha(subasta.fecha_inicio)
            div
              p(class="text-[#8A7F76] text-xs uppercase tracking-wide mb-1") Fecha Límite
              p(class="text-[#1A1614] font-semibold text-xs")= formatearFecha(subasta.fecha_fin)

      //- Columna derecha: Cronómetro + Puja manual + Auto-Puja + Pestañas (Pujas / Chat)
      div(class="space-y-6")

        //- Panel de Cronómetro
        div(class="bg-white border border-[#E2DDD5] rounded-[16px] p-6 text-center shadow-card anim-fade-up anim-fade-up-2")
          if estadoMostrar === 'programada'
            p(class="text-purple-600 text-xs uppercase tracking-wide mb-2 font-semibold") Inicia en
            div(id="cronometro" class="text-5xl font-extrabold text-purple-600 font-mono tracking-wider timer-digit") --:--
            p(class="text-[#8A7F76] text-xs mt-2") Las pujas se abrirán cuando inicie el tiempo
          else if estadoMostrar === 'activa'
            //- Tiempo total restante
            div(class="mb-4 pb-4 border-b border-[#EBE5DC]")
              div(class="flex items-center justify-center gap-1.5 text-[#8A7F76] text-xs uppercase tracking-wide mb-1 font-semibold")
                svg(class="w-4 h-4 text-[#D97706]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2")
                  path(stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z")
                span Tiempo Total
              div(id="cronometro-general" class="text-3xl font-extrabold text-[#1A1614] font-mono tracking-wider timer-digit") --:--:--

            //- Temporizador por inactividad
            div
              div(class="flex items-center justify-center gap-1.5 text-[#8A7F76] text-xs uppercase tracking-wide mb-1 font-semibold")
                span(class="w-2 h-2 rounded-full bg-[#059669] dot-live")
                span Cierre por Inactividad
              div(id="cronometro" class="text-4xl font-extrabold text-[#D97706] font-mono tracking-wider timer-digit") --:--
          else if estadoMostrar === 'finalizada'
            p(class="text-[#8A7F76] text-xs uppercase tracking-wide mb-2") Subasta finalizada
            div(class="text-3xl font-extrabold text-[#ADA69E] font-mono") 00:00
            if subasta.ganador
              div(class="mt-4 bg-[#ECFDF5] border border-[#A7F3D0] rounded-xl p-4")
                p(class="text-[#065F46] text-xs font-semibold") Ganador
                p(class="text-[#1A1614] text-base font-bold")= subasta.ganador.nombre

        //- Panel de Puja + Auto-Puja
        div(class="bg-white border border-[#E2DDD5] rounded-[16px] p-6 shadow-card anim-fade-up anim-fade-up-3")
          p(class="text-[#8A7F76] text-xs uppercase tracking-wide mb-1")= estadoMostrar === 'programada' ? 'Precio base' : 'Precio actual'
          p(id="precio-actual" class="text-3xl font-extrabold text-[#D97706] mb-4")= formatearMonto(subasta.precio_actual)

          if estadoMostrar === 'activa'
            div(id="alerta-puja-error" class="hidden mb-4 bg-[#FEF2F2] border border-[#FECACA] text-[#991B1B] text-xs p-3 rounded-xl")
              span(id="mensaje-puja-error")

            div(id="alerta-puja-exito" class="hidden mb-4 bg-[#ECFDF5] border border-[#A7F3D0] text-[#065F46] text-xs p-3 rounded-xl")
              span ¡Puja registrada correctamente!

            //- Formulario Puja Manual
            div(class="flex gap-2 mb-2")
              input(type="number" id="monto-puja" step="0.01" min="0.01" placeholder="Tu puja" class="flex-1 bg-[#EFECE6] border border-[#E2DDD5] rounded-[10px] p-3 text-[#1A1614] text-sm focus:outline-none focus:border-[#D97706] transition-all")
              button(type="button" id="btn-pujar" class="bg-[#D97706] hover:bg-[#B45309] text-white font-bold px-6 py-3 rounded-[10px] transition-colors shadow-btn whitespace-nowrap text-sm") Pujar

            p(class="text-[#8A7F76] text-xs mb-4") Puja mínima:
              span(id="puja-minima" class="text-[#1A1614] ml-1 font-medium")

            //- Sección Auto-Puja (Proxy bidding)
            details(class="border-t border-[#EBE5DC] pt-3 text-xs")
              summary(class="font-semibold text-[#1A1614] hover:text-[#D97706] cursor-pointer flex items-center justify-between select-none py-1")
                span(class="flex items-center gap-1.5")
                  svg(class="w-4 h-4 text-[#D97706]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2")
                    path(stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z")
                  span Auto-Puja (Puja Máxima)
                span(class="text-[10px] text-[#8A7F76]") Automático

              div(class="mt-3 space-y-2 bg-[#F7F4EF] p-3 rounded-xl border border-[#EBE5DC]")
                p(class="text-[#8A7F76] text-[11px]") El sistema pujará automáticamente por ti hasta alcanzar el monto máximo que indiques.
                div(id="info-auto-estado" class="hidden text-xs font-semibold text-[#065F46] bg-[#ECFDF5] border border-[#A7F3D0] p-2 rounded-lg")
                div(class="flex gap-2")
                  input(type="number" id="monto-auto-puja" step="0.01" min="0.01" placeholder="Monto máximo" class="flex-1 bg-white border border-[#E2DDD5] rounded-[8px] p-2 text-[#1A1614] text-xs focus:outline-none focus:border-[#D97706]")
                  button(type="button" id="btn-activar-auto" class="bg-[#1A1614] hover:bg-[#3D3530] text-white font-semibold px-3 py-2 rounded-[8px] text-xs transition-colors") Activar
                button(type="button" id="btn-cancelar-auto" class="text-[#DC2626] hover:underline text-[11px] block text-center w-full pt-1") Cancelar auto-puja

        //- Panel de Actividad con Pestañas: "Pujas en vivo" / "Chat en vivo"
        div(class="bg-white border border-[#E2DDD5] rounded-[16px] p-5 shadow-card anim-fade-up anim-fade-up-4")

          //- Cabecera de Pestañas
          div(class="flex items-center border-b border-[#EBE5DC] mb-4")
            button(
              type="button"
              id="tab-pujas-btn"
              class="flex-1 pb-3 text-center text-sm font-bold border-b-2 border-[#D97706] text-[#D97706] transition-colors"
            ) Pujas en vivo
            button(
              type="button"
              id="tab-chat-btn"
              class="flex-1 pb-3 text-center text-sm font-bold border-b-2 border-transparent text-[#8A7F76] hover:text-[#1A1614] transition-colors flex items-center justify-center gap-1.5"
            )
              span Chat en vivo
              span(class="w-2 h-2 rounded-full bg-[#059669] dot-live")

          //- Pestaña 1: Pujas en vivo
          div(id="panel-pujas")
            div(id="lista-pujas" class="space-y-2 max-h-72 overflow-y-auto pr-1")
              if pujas && pujas.length > 0
                each puja in pujas
                  div(class="flex items-center justify-between bg-[#F7F4EF] rounded-xl px-4 py-3 border border-[#EBE5DC]")
                    div(class="flex items-center gap-3")
                      div(class="w-8 h-8 rounded-full bg-[#FFFBEB] border border-[#FDE68A] flex items-center justify-center text-xs font-bold text-[#D97706]")= puja.usuario.charAt(0).toUpperCase()
                      div
                        p(class="text-sm font-semibold text-[#1A1614]")= puja.usuario
                        p(class="text-xs text-[#8A7F76]")= formatearFecha(puja.fecha)
                    p(class="text-[#D97706] font-bold text-sm")= formatearMonto(puja.monto)
              else
                div(class="text-center py-8 text-[#8A7F76] text-xs") Aún no hay pujas. ¡Sé el primero!

          //- Pestaña 2: Chat en vivo
          div(id="panel-chat" class="hidden flex flex-col h-80")
            div(id="lista-chat" class="flex-1 overflow-y-auto pr-1 space-y-2 mb-3")
              div(class="text-center py-8 text-[#8A7F76] text-xs") Cargando chat...

            //- Input de chat
            div(class="flex gap-2 pt-2 border-t border-[#EBE5DC]")
              input(type="text" id="mensaje-chat" maxlength="500" placeholder="Escribe un mensaje..." class="flex-1 bg-[#EFECE6] border border-[#E2DDD5] rounded-[10px] p-2.5 text-xs text-[#1A1614] focus:outline-none focus:border-[#D97706]")
              button(type="button" id="btn-enviar-chat" class="bg-[#D97706] hover:bg-[#B45309] text-white text-xs font-bold px-4 py-2.5 rounded-[10px] transition-colors") Enviar

  //- Datos para el JS del cliente
  if subasta
    input(type="hidden" id="subasta-id" value=subasta.id)
    input(type="hidden" id="subasta-estado" value=subasta.estado)
    input(type="hidden" id="subasta-estado-efectivo" value=estadoMostrar)
    input(type="hidden" id="subasta-precio-actual" value=subasta.precio_actual)
    input(type="hidden" id="subasta-fecha-inicio" value=subasta.fecha_inicio)
    input(type="hidden" id="subasta-fecha-fin" value=subasta.fecha_fin)

block scripts
  if subasta && (subasta.estado === 'activa' || estadoMostrar === 'programada')
    script(src="/js/subasta-tiempo-real.js")
  script.
    // Botón favorito en la vista de detalle
    const btnFavDetalle = document.getElementById('btn-fav-detalle');
    if (btnFavDetalle) {
      const token = localStorage.getItem('token');
      const subastaId = btnFavDetalle.dataset.subastaId;

      // Verificar si ya es favorito al cargar
      if (token) {
        fetch('/api/usuario/favoritos', {
          headers: { 'Authorization': 'Bearer ' + token },
          credentials: 'include'
        }).then(r => r.json()).then(datos => {
          if (datos.exito && datos.datos.favoritosIds) {
            if (datos.datos.favoritosIds.includes(subastaId)) {
              marcarFavDetalle(true);
            }
          }
        }).catch(err => console.error(err));
      }

      btnFavDetalle.addEventListener('click', async () => {
        if (!token) {
          alert('Debes iniciar sesión para guardar favoritos.');
          return;
        }
        try {
          const resp = await fetch(`/api/usuario/favoritos/${subastaId}`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': 'Bearer ' + token
            },
            credentials: 'include'
          });
          const datos = await resp.json();
          if (datos.exito) {
            marcarFavDetalle(datos.datos.favorito);
          }
        } catch (err) {
          console.error(err);
        }
      });

      function marcarFavDetalle(esFav) {
        const icono = btnFavDetalle.querySelector('.icono-corazon');
        const span = btnFavDetalle.querySelector('span');
        if (esFav) {
          btnFavDetalle.classList.add('bg-[#FEF2F2]', 'border-[#FECACA]', 'text-[#DC2626]');
          icono.setAttribute('fill', 'currentColor');
          span.textContent = 'En Favoritos';
        } else {
          btnFavDetalle.classList.remove('bg-[#FEF2F2]', 'border-[#FECACA]', 'text-[#DC2626]');
          icono.setAttribute('fill', 'none');
          span.textContent = 'Guardar en Favoritos';
        }
      }
    }
