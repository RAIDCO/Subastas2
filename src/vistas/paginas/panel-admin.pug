extends ../disenos/autenticado.pug

block contenido

    .max-w-7xl.mx-auto.p-8

        h1.text-4xl.font-bold.text-white.mb-2 Panel de Moderación de Subastas

        p.text-slate-400.mb-8
            | Administra las subastas pendientes de aprobación.

        if subastas && subastas.length > 0

            .overflow-x-auto

                table.w-full.bg-slate-900.border.border-slate-800.rounded-lg

                    thead.bg-emerald-600

                        tr
                            th.p-4.text-left.text-white Título
                            th.p-4.text-left.text-white Usuario
                            th.p-4.text-left.text-white Categoría
                            th.p-4.text-left.text-white Estado
                            th.p-4.text-center.text-white Acciones

                    tbody

                        each subasta in subastas

                            tr.border-b.border-slate-700

                                td.p-4.text-white
                                    = subasta.titulo

                                td.p-4.text-slate-300
                                    = subasta.Usuario.nombre

                                td.p-4.text-slate-300
                                    = subasta.Categoria.nombre

                                td.p-4
                                    span.bg-yellow-500.text-black.px-3.py-1.rounded
                                        = subasta.estado

                                td.p-4

                                    .flex.justify-center.gap-2

                                        form(action=`/api/administrador/aprobar/${subasta.id}` method="POST")
                                            button.bg-emerald-600.hover:bg-emerald-700.text-white.px-4.py-2.rounded(type="submit")
                                                | Aprobar

                                        form(action=`/api/administrador/rechazar/${subasta.id}` method="POST")
                                            button.bg-red-600.hover:bg-red-700.text-white.px-4.py-2.rounded(type="submit")
                                                | Rechazar

        else

            .bg-slate-900.border.border-slate-800.rounded-lg.p-8.text-center

                h2.text-white.text-2xl.mb-3
                    | No hay subastas pendientes

                p.text-slate-400
                    | Todas las subastas ya fueron revisadas.