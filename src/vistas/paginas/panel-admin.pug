extends ../disenos/autenticado.pug

block contenido
  div(class="max-w-7xl mx-auto")

    div(class="mb-8 anim-fade-up")
      h1(class="text-2xl font-bold text-[#1A1614] mb-2") Panel de Moderación de Subastas
      p(class="text-[#8A7F76] text-sm") Administra las subastas pendientes de aprobación antes de hacerlas públicas.

    if subastas && subastas.length > 0

      div(class="bg-white border border-[#E2DDD5] rounded-[16px] overflow-hidden shadow-card anim-fade-up anim-fade-up-1")
        div(class="overflow-x-auto")

          table(class="w-full text-left border-collapse")

            thead(class="bg-[#F7F4EF] text-[#8A7F76] text-xs font-semibold uppercase tracking-wider border-b border-[#E2DDD5]")
              tr
                th(class="p-4") Título
                th(class="p-4") Usuario
                th(class="p-4") Categoría
                th(class="p-4") Estado
                th(class="p-4 text-center") Acciones

            tbody(class="divide-y divide-[#EBE5DC] text-sm")

              each subasta in subastas
                tr(class="hover:bg-[#F7F4EF] transition-colors")

                  td(class="p-4 font-semibold text-[#1A1614]")= subasta.titulo

                  td(class="p-4 text-[#3D3530]")= subasta.vendedor ? subasta.vendedor.nombre : 'Usuario desconocido'

                  td(class="p-4 text-[#3D3530]")
                    span(class="bg-[#EFECE6] text-[#3D3530] text-xs font-medium px-2.5 py-1 rounded-full border border-[#E2DDD5]")= subasta.categoria ? subasta.categoria.nombre : 'General'

                  td(class="p-4")
                    span(class="bg-[#FFFBEB] text-[#92400E] border border-[#FDE68A] text-xs font-semibold px-2.5 py-1 rounded-full inline-flex items-center gap-1.5")
                      svg(class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2")
                        path(stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z")
                      = subasta.estado.toUpperCase()

                  td(class="p-4")
                    div(class="flex items-center justify-center gap-3")

                      form(action=`/api/administrador/aprobar/${subasta.id}` method="POST")
                        button(type="submit" class="bg-[#059669] hover:bg-[#047857] text-white font-semibold text-xs px-4 py-2 rounded-[10px] transition-colors")
                          | Aprobar

                      form(action=`/api/administrador/rechazar/${subasta.id}` method="POST")
                        button(type="submit" class="bg-[#FEF2F2] hover:bg-[#DC2626] text-[#DC2626] hover:text-white border border-[#FECACA] font-semibold text-xs px-4 py-2 rounded-[10px] transition-colors")
                          | Rechazar

    else

      div(class="bg-white border border-[#E2DDD5] rounded-[16px] p-12 text-center max-w-lg mx-auto mt-12 shadow-card anim-fade-up")
        div(class="w-16 h-16 rounded-2xl bg-[#ECFDF5] border border-[#A7F3D0] text-[#059669] flex items-center justify-center mx-auto mb-4")
          svg(class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z")

        h2(class="text-[#1A1614] text-xl font-bold mb-2") No hay subastas pendientes
        p(class="text-[#8A7F76] text-sm") Todas las subastas publicadas han sido revisadas.