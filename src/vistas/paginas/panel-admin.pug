extends ../disenos/autenticado.pug

block contenido
  div(class="max-w-7xl mx-auto p-4 sm:p-6 lg:p-8")

    div(class="mb-8")
      h1(class="text-3xl font-bold text-white mb-2") Panel de Moderación de Subastas
      p(class="text-slate-400") Administra las subastas pendientes de aprobación antes de hacerlas públicas.

    if subastas && subastas.length > 0

      div(class="bg-slate-900/60 border border-slate-800 rounded-2xl overflow-hidden shadow-xl")
        div(class="overflow-x-auto")

          table(class="w-full text-left border-collapse")

            thead(class="bg-slate-800/80 text-slate-300 text-xs font-semibold uppercase tracking-wider border-b border-slate-700")
              tr
                th(class="p-4") Título
                th(class="p-4") Usuario
                th(class="p-4") Categoría
                th(class="p-4") Estado
                th(class="p-4 text-center") Acciones

            tbody(class="divide-y divide-slate-800 text-sm")

              each subasta in subastas
                tr(class="hover:bg-slate-800/40 transition-colors")

                  td(class="p-4 font-semibold text-white")= subasta.titulo

                  td(class="p-4 text-slate-300")= subasta.vendedor ? subasta.vendedor.nombre : 'Usuario desconocido'

                  td(class="p-4 text-slate-300")
                    span(class="bg-slate-800 text-slate-300 text-xs font-medium px-2.5 py-1 rounded-full border border-slate-700")= subasta.categoria ? subasta.categoria.nombre : 'General'

                  td(class="p-4")
                    span(class="bg-amber-500/10 text-amber-400 border border-amber-500/20 text-xs font-semibold px-2.5 py-1 rounded-full")
                      = subasta.estado.toUpperCase()

                  td(class="p-4")
                    div(class="flex items-center justify-center gap-3")

                      form(action=`/api/administrador/aprobar/${subasta.id}` method="POST")
                        button(type="submit" class="bg-emerald-500 hover:bg-emerald-600 text-white font-semibold text-xs px-4 py-2 rounded-lg transition-colors shadow-md shadow-emerald-500/10")
                          | Aprobar

                      form(action=`/api/administrador/rechazar/${subasta.id}` method="POST")
                        button(type="submit" class="bg-rose-500/20 hover:bg-rose-500 text-rose-400 hover:text-white border border-rose-500/30 font-semibold text-xs px-4 py-2 rounded-lg transition-colors")
                          | Rechazar

    else

      div(class="bg-slate-900/60 border border-slate-800 rounded-2xl p-12 text-center max-w-lg mx-auto mt-12")
        div(class="w-16 h-16 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center mx-auto mb-4")
          svg(class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z")

        h2(class="text-white text-xl font-bold mb-2") No hay subastas pendientes
        p(class="text-slate-400 text-sm") Todas las subastas publicadas han sido revisadas.