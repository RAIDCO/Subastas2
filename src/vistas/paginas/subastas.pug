extends ../disenos/autenticado.pug

block contenido
  //- Encabezado de la página
  div(class="mb-8")
    h1(class="text-2xl font-bold text-white") Subastas activas
    p(class="text-slate-400 mt-1") Explora, filtra y puja en tiempo real por artículos únicos.

  //- Filtros por categoría (pills)
  div(class="bg-slate-900/60 border border-slate-800 rounded-xl p-4 mb-6")
    div(class="flex flex-wrap gap-2 mb-4")
      - const categorias = ['Todas', 'Tecnología', 'Coleccionables', 'Arte', 'Vehículos', 'Instrumentos']
      each cat in categorias
        button(class=`px-4 py-1.5 rounded-full text-sm font-medium transition-colors ${cat === 'Todas' ? 'bg-emerald-500 text-white' : 'bg-slate-800 text-slate-300 hover:bg-slate-700 hover:text-white border border-slate-700'}`)= cat

    //- Filtros de estado y ordenar
    div(class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4")
      //- Filtros de estado
      div(class="flex items-center gap-1 text-sm")
        span(class="text-slate-500 mr-2") Estado:
        - const estados = ['Todas', 'En vivo ahora', 'Próximamente', 'Finalizadas']
        each estado in estados
          button(class=`px-3 py-1 rounded-md font-medium transition-colors ${estado === 'Todas' ? 'text-white bg-slate-800' : 'text-slate-400 hover:text-white hover:bg-slate-800'}`)= estado

      //- Ordenar por
      div(class="flex items-center gap-2 text-sm")
        span(class="text-slate-500") Ordenar por:
        select(class="bg-slate-800 border border-slate-700 text-slate-200 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:border-emerald-500")
          option Tiempo por finalizar
          option Menor precio
          option Mayor precio
          option Más recientes

  //- Grid de subastas
  if subastas && subastas.length > 0
    //- Grid con subastas reales (se llenará automáticamente cuando la BD esté conectada)
    div(class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6")
      each subasta in subastas
        a(href=`/subastas/${subasta.id}` class="block group")
          article(class="bg-slate-900/60 border border-slate-800 rounded-2xl overflow-hidden hover:border-slate-700 transition-all duration-300 flex flex-col")
            //- Imagen del artículo
            div(class="relative h-56 overflow-hidden bg-slate-950")
              if subasta.imagen_url
                img(src=subasta.imagen_url alt=subasta.titulo class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500")
              else
                div(class="w-full h-full flex items-center justify-center text-slate-600")
                  svg(class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                    path(stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z")

              //- Badge de categoría
              div(class="absolute top-3 left-3 bg-slate-950/80 backdrop-blur-md px-3 py-1 rounded-full text-xs font-semibold text-slate-300 border border-slate-700")= subasta.categoria ? subasta.categoria.nombre : 'General'

              //- Badge de estado
              if subasta.estado === 'activa'
                div(class="absolute top-3 right-3 bg-red-500/90 text-white px-3 py-1 rounded-full text-xs font-bold flex items-center gap-1.5")
                  span(class="w-1.5 h-1.5 rounded-full bg-white animate-pulse")
                  span EN VIVO
              else if subasta.estado === 'finalizada'
                div(class="absolute top-3 right-3 bg-slate-700/90 text-slate-300 px-3 py-1 rounded-full text-xs font-bold flex items-center gap-1.5")
                  span • FINALIZADA

            //- Info de la subasta
            div(class="p-5 flex flex-col flex-grow")
              h3(class="text-base font-bold text-white mb-1 group-hover:text-emerald-400 transition-colors line-clamp-1")= subasta.titulo
              p(class="text-slate-500 text-xs mb-4")= subasta.creador ? `por ${subasta.creador.nombre}` : 'por Vendedor'

              //- Precio y tiempo
              div(class="mt-auto flex items-center justify-between pt-4 border-t border-slate-800/60")
                div
                  if subasta.estado === 'finalizada'
                    div(class="flex items-center gap-2 text-slate-400")
                      svg(class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                        path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z")
                      span(class="text-sm font-medium") Finalizada
                  else
                    div
                      span(class="text-xs text-slate-500 block") Puja actual
                      span(class="text-lg font-extrabold text-emerald-400") $#{subasta.precio_actual || subasta.precio_inicial}

                if subasta.estado === 'activa'
                  div(class="text-right")
                    span(class="text-xs text-slate-500 block") Cierra en
                    span(class="cuenta-regresiva text-lg font-bold text-red-400 font-mono" data-fecha-fin=subasta.fecha_fin) --:--

  else
    //- Estado vacío: no hay subastas (skeleton/placeholder)
    div(class="text-center py-20")
      div(class="mx-auto w-20 h-20 rounded-2xl bg-slate-900 border border-slate-800 flex items-center justify-center mb-6")
        svg(class="w-10 h-10 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24")
          path(stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10")
      h3(class="text-xl font-bold text-slate-300 mb-2") No hay subastas activas en este momento
      p(class="text-slate-500 max-w-md mx-auto mb-6") Las subastas publicadas aparecerán aquí una vez que sean aprobadas por un administrador. ¡Sé el primero en publicar!
      a(href="/crear-subasta" class="inline-flex items-center gap-2 bg-emerald-500 hover:bg-emerald-600 text-white font-semibold px-6 py-3 rounded-xl transition-colors")
        svg(class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24")
          path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4")
        span Publicar una Subasta

block scripts
  script.
    function actualizarCuentasRegresivas() {
      const elementos = document.querySelectorAll('.cuenta-regresiva');
      const ahora = new Date().getTime();

      elementos.forEach((el) => {
        const fechaFinAttr = el.getAttribute('data-fecha-fin');
        if (!fechaFinAttr) return;

        const fechaFin = new Date(fechaFinAttr).getTime();
        const diferencia = fechaFin - ahora;

        if (diferencia <= 0) {
          el.textContent = '00:00:00';
          return;
        }

        const horas = Math.floor(diferencia / (1000 * 60 * 60));
        const minutos = Math.floor((diferencia % (1000 * 60 * 60)) / (1000 * 60));
        const segundos = Math.floor((diferencia % (1000 * 60)) / 1000);

        const h = String(horas).padStart(2, '0');
        const m = String(minutos).padStart(2, '0');
        const s = String(segundos).padStart(2, '0');

        el.textContent = horas > 0 ? `${h}:${m}:${s}` : `${m}:${s}`;
      });
    }

    actualizarCuentasRegresivas();
    setInterval(actualizarCuentasRegresivas, 1000);
