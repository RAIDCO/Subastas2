extends ../disenos/autenticado.pug

block contenido
  //- Helper para construir URLs conservando filtros existentes
  -
    const construirUrlFiltro = (paramsNuevos) => {
      const actual = {
        buscar: buscar || '',
        categoria: categoriaSel || 'Todas',
        estado: estadoSel || 'activa',
        orden: ordenSel || 'recientes',
        precioMin: precioMin || '',
        precioMax: precioMax || '',
        ...paramsNuevos
      };
      const query = new URLSearchParams();
      if (actual.buscar) query.set('buscar', actual.buscar);
      if (actual.categoria && actual.categoria !== 'Todas') query.set('categoria', actual.categoria);
      if (actual.estado && actual.estado !== 'activa') query.set('estado', actual.estado);
      if (actual.orden && actual.orden !== 'recientes') query.set('orden', actual.orden);
      if (actual.precioMin) query.set('precioMin', actual.precioMin);
      if (actual.precioMax) query.set('precioMax', actual.precioMax);
      const queryString = query.toString();
      return `/subastas${queryString ? '?' + queryString : ''}`;
    };

  //- Encabezado de la página
  div(class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4 anim-fade-up")
    div
      h1(class="text-2xl font-bold text-[#1A1614]") Subastas Activas y Catálogo
      p(class="text-[#8A7F76] mt-1 text-sm") Explora, filtra y puja en tiempo real por artículos únicos.

    if buscar
      div(class="flex items-center gap-2 bg-[#FFFBEB] border border-[#FDE68A] text-[#D97706] px-4 py-2 rounded-full text-sm font-medium")
        svg(class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2")
          path(stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z")
        span Resultados para: "#{buscar}"
        a(href=construirUrlFiltro({ buscar: '' }) class="hover:text-[#B45309] font-bold ml-2")
          svg(class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2")
            path(stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12")

  //- Panel de Filtros por Categoría, Estado y Orden
  div(class="bg-white border border-[#E2DDD5] rounded-[16px] p-4 mb-6 shadow-card space-y-4 anim-fade-up anim-fade-up-1")

    //- 1. Filtro por Categorías (pills)
    div(class="flex flex-wrap items-center gap-2")
      span(class="text-[#8A7F76] text-xs font-semibold uppercase tracking-wider mr-2") Categoría:
      - const listaCategorias = (categorias && categorias.length > 0) ? categorias : ['Todas', 'Tecnología', 'Coleccionables', 'Arte', 'Vehículos', 'Instrumentos', 'Hogar', 'Moda', 'Deportes', 'Joyería', 'Inmuebles', 'Otros']
      each cat in listaCategorias
        a(
          href=construirUrlFiltro({ categoria: cat })
          class=`px-4 py-1.5 rounded-full text-xs font-semibold transition-all ${ (categoriaSel || 'Todas') === cat ? 'bg-[#D97706] text-white shadow-btn' : 'bg-[#EFECE6] text-[#3D3530] hover:bg-[#E2DDD5] hover:text-[#1A1614] border border-[#E2DDD5]' }`
        )= cat

    //- 2. Filtro por Estado y Ordenación
    form(id="form-filtros" action="/subastas" method="GET" class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-3 border-t border-[#EBE5DC]")

      //- Mantenemos buscar y categoria en inputs hidden para no perderlos al usar los selects
      if buscar
        input(type="hidden" name="buscar" value=buscar)
      if categoriaSel && categoriaSel !== 'Todas'
        input(type="hidden" name="categoria" value=categoriaSel)

      //- Filtros de estado (En vivo / Próximamente / Finalizadas (24h) / Todas)
      div(class="flex flex-wrap items-center gap-1.5 text-xs font-medium")
        span(class="text-[#8A7F76] mr-2") Estado:
        -
          const estados = [
            { clave: 'activa', label: 'En vivo ahora', icono: 'M13 10V3L4 14h7v7l9-11h-7z' },
            { clave: 'programada', label: 'Próximamente', icono: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z' },
            { clave: 'finalizada', label: 'Finalizadas (Últimas 24h)', icono: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' },
            { clave: 'todas', label: 'Todas', icono: 'M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z' }
          ]
        each est in estados
          a(
            href=construirUrlFiltro({ estado: est.clave })
            class=`flex items-center gap-1.5 px-3 py-1.5 rounded-lg transition-all ${ (estadoSel || 'activa') === est.clave ? 'bg-[#1A1614] text-white font-bold' : 'text-[#8A7F76] hover:text-[#1A1614] hover:bg-[#EFECE6]' }`
          )
            svg(class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2")
              path(stroke-linecap="round" stroke-linejoin="round" d=est.icono)
            span= est.label

      //- Selector de orden
      div(class="flex items-center gap-2 text-xs text-[#8A7F76]")
        label(for="orden" class="whitespace-nowrap") Ordenar por:
        select(
          id="orden"
          name="orden"
          onchange="this.form.submit()"
          class="bg-[#EFECE6] border border-[#E2DDD5] text-[#1A1614] rounded-[10px] px-3 py-1.5 text-xs focus:outline-none focus:border-[#D97706] transition-colors"
        )
          option(value="recientes" selected=(ordenSel === 'recientes')) Más recientes
          option(value="menor-precio" selected=(ordenSel === 'menor-precio')) Menor precio
          option(value="mayor-precio" selected=(ordenSel === 'mayor-precio')) Mayor precio
          option(value="tiempo" selected=(ordenSel === 'tiempo')) Tiempo por finalizar

    //- 3. Filtro por rango de precio
    div(class="flex flex-wrap items-center gap-2 pt-3 border-t border-[#EBE5DC]")
      span(class="text-[#8A7F76] text-xs font-semibold uppercase tracking-wider mr-2") Precio:
      form(action="/subastas" method="GET" class="flex flex-wrap items-center gap-2")
        if buscar
          input(type="hidden" name="buscar" value=buscar)
        if categoriaSel && categoriaSel !== 'Todas'
          input(type="hidden" name="categoria" value=categoriaSel)
        if estadoSel && estadoSel !== 'activa'
          input(type="hidden" name="estado" value=estadoSel)
        if ordenSel && ordenSel !== 'recientes'
          input(type="hidden" name="orden" value=ordenSel)
        div(class="flex items-center gap-1.5")
          span(class="text-[#8A7F76] text-xs") $
          input(type="number" name="precioMin" placeholder="Mín" value=precioMin step="0.01" min="0" class="w-24 bg-[#EFECE6] border border-[#E2DDD5] text-[#1A1614] rounded-[10px] px-2.5 py-1.5 text-xs focus:outline-none focus:border-[#D97706] transition-colors")
        span(class="text-[#ADA69E] text-xs") —
        div(class="flex items-center gap-1.5")
          span(class="text-[#8A7F76] text-xs") $
          input(type="number" name="precioMax" placeholder="Máx" value=precioMax step="0.01" min="0" class="w-24 bg-[#EFECE6] border border-[#E2DDD5] text-[#1A1614] rounded-[10px] px-2.5 py-1.5 text-xs focus:outline-none focus:border-[#D97706] transition-colors")
        button(type="submit" class="bg-[#1A1614] hover:bg-[#3D3530] text-white text-xs font-semibold px-4 py-1.5 rounded-lg transition-colors") Filtrar
        if precioMin || precioMax
          a(href=construirUrlFiltro({ precioMin: '', precioMax: '' }) class="text-[#DC2626] hover:text-[#991B1B] text-xs font-medium ml-1") Limpiar

  //- Grid de subastas
  if subastas && subastas.length > 0
    div(class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6")
      each subasta, index in subastas
        a(href=`/subastas/${subasta.id}` class=`block group h-full relative anim-fade-up anim-fade-up-${Math.min(index + 1, 6)}`)
          article(class="bg-white border border-[#E2DDD5] rounded-[16px] overflow-hidden card-interactive shadow-card flex flex-col h-full")

            //- Imagen del artículo
            div(class="relative h-56 overflow-hidden bg-[#EFECE6]")
              if subasta.imagen_url
                img(src=subasta.imagen_url alt=subasta.titulo class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500")
              else
                div(class="w-full h-full flex items-center justify-center text-[#E2DDD5]")
                  svg(class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                    path(stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z")

              //- Badge de categoría
              div(class="absolute top-3 left-3 bg-[#FFF7ED]/95 backdrop-blur-md px-3 py-1 rounded-full text-xs font-semibold text-[#C2410C] border border-[#FFEDD5]")
                = subasta.categoria ? subasta.categoria.nombre : 'General'

              //- Badge de estado
              - const est = subasta.estadoEfectivo || subasta.estado
              if est === 'activa'
                div(class="absolute top-3 right-3 bg-[#059669] text-white px-3 py-1 rounded-full text-xs font-bold flex items-center gap-1.5 shadow-md badge-live")
                  span(class="w-1.5 h-1.5 rounded-full bg-white dot-live")
                  span EN VIVO
              else if est === 'programada'
                div(class="absolute top-3 right-3 bg-purple-50 text-purple-700 border border-purple-200 px-3 py-1 rounded-full text-xs font-bold flex items-center gap-1.5 shadow-md")
                  svg(class="w-3 h-3 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2")
                    path(stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z")
                  span PROGRAMADA
              else if est === 'pendiente'
                div(class="absolute top-3 right-3 bg-[#FFFBEB] text-[#92400E] px-3 py-1 rounded-full text-xs font-bold flex items-center gap-1.5 border border-[#FDE68A] shadow-md")
                  svg(class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2")
                    path(stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z")
                  span PENDIENTE
              else if est === 'finalizada'
                div(class="absolute top-3 right-3 bg-[#EFECE6] text-[#8A7F76] px-3 py-1 rounded-full text-xs font-bold border border-[#E2DDD5] flex items-center gap-1.5 shadow-md")
                  svg(class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2")
                    path(stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z")
                  span FINALIZADA
              else if est === 'rechazada'
                div(class="absolute top-3 right-3 bg-[#FEF2F2] text-[#991B1B] px-3 py-1 rounded-full text-xs font-bold border border-[#FECACA] flex items-center gap-1.5 shadow-md")
                  svg(class="w-3 h-3 text-[#DC2626]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2")
                    path(stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12")
                  span RECHAZADA

              //- Botón favorito (corazón en la esquina inferior derecha de la imagen)
              button(
                type="button"
                data-subasta-id=subasta.id
                class="btn-favorito absolute bottom-3 right-3 z-20 w-8 h-8 rounded-full bg-white/90 backdrop-blur-sm border border-[#E2DDD5] flex items-center justify-center hover:bg-[#FEF2F2] hover:border-[#FECACA] transition-all shadow-sm"
                title="Guardar en favoritos"
              )
                svg(class="w-4 h-4 text-[#ADA69E] icono-corazon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2")
                  path(stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z")

            //- Info de la subasta
            div(class="p-5 flex flex-col flex-grow")
              h3(class="text-base font-bold text-[#1A1614] mb-1 group-hover:text-[#D97706] transition-colors line-clamp-1")= subasta.titulo
              p(class="text-[#ADA69E] text-xs mb-4")= subasta.creador ? `Publicado por ${subasta.creador.nombre}` : 'Por Vendedor'

              //- Precio y tiempo
              div(class="mt-auto flex items-center justify-between pt-4 border-t border-[#EBE5DC]")
                div
                  span(class="text-xs text-[#8A7F76] block")= subasta.estado === 'finalizada' ? 'Precio final' : 'Puja actual'
                  span(class="text-lg font-extrabold text-[#D97706]") $#{Number(subasta.precio_actual || subasta.precio_inicial).toLocaleString('es-MX', { minimumFractionDigits: 2 })}

                if subasta.estado === 'activa'
                  div(class="text-right")
                    span(class="text-xs text-[#8A7F76] block") Inactividad
                    span(class="text-xs font-medium text-[#3D3530]") #{subasta.tiempo_inactividad_minutos} min

  else
    //- Estado vacío cuando no hay resultados para la búsqueda/filtro
    div(class="bg-white border border-[#E2DDD5] rounded-[16px] text-center py-20 px-6 max-w-lg mx-auto my-8 shadow-card anim-fade-up")
      div(class="mx-auto w-20 h-20 rounded-2xl bg-[#EFECE6] border border-[#E2DDD5] flex items-center justify-center mb-6")
        svg(class="w-10 h-10 text-[#ADA69E]" fill="none" stroke="currentColor" viewBox="0 0 24 24")
          path(stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z")

      h3(class="text-xl font-bold text-[#1A1614] mb-2") No se encontraron subastas
      p(class="text-[#8A7F76] text-sm mb-6") Intenta ajustar los filtros de búsqueda o categoría para encontrar más artículos.
      div(class="flex justify-center gap-3")
        a(href="/subastas" class="bg-[#EFECE6] hover:bg-[#E2DDD5] text-[#1A1614] font-semibold text-xs px-5 py-2.5 rounded-[10px] border border-[#E2DDD5] transition-colors") Limpiar filtros
        a(href="/crear-subasta" class="bg-[#D97706] hover:bg-[#B45309] text-white font-semibold text-xs px-5 py-2.5 rounded-[10px] transition-colors shadow-btn") Publicar Subasta

block scripts
  script.
    document.addEventListener('DOMContentLoaded', async () => {
      const token = localStorage.getItem('token');
      if (!token) return;

      // Obtener lista de favoritos del usuario
      try {
        const resp = await fetch('/api/usuario/favoritos', {
          headers: { 'Authorization': 'Bearer ' + token },
          credentials: 'include'
        });
        const datos = await resp.json();
        if (datos.exito && datos.datos.favoritosIds) {
          const ids = new Set(datos.datos.favoritosIds);
          document.querySelectorAll('.btn-favorito').forEach(btn => {
            const subastaId = btn.dataset.subastaId;
            if (ids.has(subastaId)) {
              marcarFavorito(btn, true);
            }
          });
        }
      } catch (err) {
        console.error('Error al cargar favoritos:', err);
      }

      // Event listener para botones de favorito
      document.querySelectorAll('.btn-favorito').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          e.preventDefault();
          e.stopPropagation();
          const subastaId = btn.dataset.subastaId;

          try {
            const resp = await fetch(`/api/usuario/favoritos/${subastaId}`, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Authorization': 'Bearer ' + token
              },
              credentials: 'include'
            });
            const datos = await resp.json();
            if (datos.exito) {
              marcarFavorito(btn, datos.datos.favorito);
            }
          } catch (err) {
            console.error('Error al cambiar favorito:', err);
          }
        });
      });

      function marcarFavorito(btn, esFav) {
        const icono = btn.querySelector('.icono-corazon');
        if (esFav) {
          btn.classList.add('bg-[#FEF2F2]', 'border-[#FECACA]');
          icono.setAttribute('fill', 'currentColor');
          icono.classList.remove('text-[#ADA69E]');
          icono.classList.add('text-[#DC2626]');
        } else {
          btn.classList.remove('bg-[#FEF2F2]', 'border-[#FECACA]');
          icono.setAttribute('fill', 'none');
          icono.classList.remove('text-[#DC2626]');
          icono.classList.add('text-[#ADA69E]');
        }
      }
    });
