//- Formulario de inicio de sesión de usuario
doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= titulo
    script(src="https://cdn.tailwindcss.com")

  body(class="bg-slate-950 flex items-center justify-center min-h-screen")

    .w-full.max-w-md.bg-slate-900/60.border.border-slate-800.rounded-2xl.shadow-xl.p-8

      h1.text-3xl.font-bold.text-center.text-white.mb-2 Iniciar Sesión en SubastasPro
      p.text-center.text-slate-400.mb-8 Ingresa tus datos para continuar.

      form(action="/api/autenticacion/login" method="POST" class="space-y-5")

        div
          label.block.text-slate-300.mb-2 Correo electrónico
          input.w-full.bg-slate-800.border.border-slate-700.rounded-lg.p-3.text-white(
          type="email"
          name="correo"
          placeholder="tu@correo.com"
          required)

        div
          label.block.text-slate-300.mb-2 Contraseña
          input.w-full.bg-slate-800.border.border-slate-700.rounded-lg.p-3.text-white(
          type="password"
          name="clave"
          placeholder="********"
          required)

        .flex.justify-between.items-center
          label.flex.items-center.gap-2.text-slate-400
            input(type="checkbox")
            | Recordarme

          a.text-emerald-400.hover:underline(href="#") ¿Olvidaste tu contraseña?

        button.w-full.bg-emerald-500.hover:bg-emerald-600.text-white.font-semibold.py-3.rounded-lg
          | Iniciar Sesión

      p.text-center.text-slate-400.mt-6
        | ¿No tienes cuenta?
        a.text-emerald-400.ml-1.hover:underline(href="/registro") Regístrate aquí