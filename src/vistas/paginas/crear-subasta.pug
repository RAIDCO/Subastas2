extends ../disenos/autenticado.pug

block contenido

  div(class="max-w-3xl mx-auto")

    div(class="mb-8 anim-fade-up")
      h1(class="text-2xl lg:text-3xl font-bold text-[#1A1614]") Publicar Nueva Subasta
      p(class="text-[#8A7F76] mt-1 text-sm") Completa el formulario para enviar tu artículo a revisión.

    //- Alerta de error
    div(id="alerta-error" class="hidden mb-6 bg-[#FEF2F2] border border-[#FECACA] text-[#991B1B] text-sm p-4 rounded-xl flex items-center gap-2")
      svg(class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24")
        path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z")
      span(id="mensaje-error")

    //- Alerta de éxito
    div(id="alerta-exito" class="hidden mb-6 bg-[#ECFDF5] border border-[#A7F3D0] text-[#065F46] text-sm p-4 rounded-xl flex items-center gap-2")
      svg(class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24")
        path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7")
      span(id="mensaje-exito") ¡Subasta publicada correctamente! Un administrador la revisará pronto.

    //- Formulario
    div(class="bg-white border border-[#E2DDD5] rounded-[16px] p-6 lg:p-8 shadow-card anim-fade-up anim-fade-up-1")

      form(id="form-crear-subasta" enctype="multipart/form-data" class="space-y-6")

        //- Título
        div
          label(for="titulo" class="block text-[#1A1614] mb-2 text-sm font-medium") Título del artículo
          input(type="text" id="titulo" name="titulo" required minlength="5" maxlength="150" placeholder="Ej: MacBook Pro 14 pulgadas 2024" class="w-full bg-[#EFECE6] border border-[#E2DDD5] rounded-[10px] p-3 text-[#1A1614] placeholder-[#ADA69E] focus:outline-none focus:border-[#D97706] focus:ring-2 focus:ring-[#FDE68A] transition-all")
          p(class="text-[#ADA69E] text-xs mt-1") Entre 5 y 150 caracteres.

        //- Descripción
        div
          label(for="descripcion" class="block text-[#1A1614] mb-2 text-sm font-medium") Descripción
          textarea(id="descripcion" name="descripcion" required rows="4" placeholder="Describe tu artículo: condición, especificaciones, historia, etc." class="w-full bg-[#EFECE6] border border-[#E2DDD5] rounded-[10px] p-3 text-[#1A1614] placeholder-[#ADA69E] focus:outline-none focus:border-[#D97706] focus:ring-2 focus:ring-[#FDE68A] transition-all resize-none")

        //- Precio y Tiempo en grid
        div(class="grid grid-cols-1 md:grid-cols-2 gap-6")

          //- Precio inicial
          div
            label(for="precio_inicial" class="block text-[#1A1614] mb-2 text-sm font-medium") Precio inicial (MXN)
            div(class="relative")
              span(class="absolute left-3 top-1/2 -translate-y-1/2 text-[#8A7F76] font-semibold") $
              input(type="number" id="precio_inicial" name="precio_inicial" required min="0.01" step="0.01" placeholder="100.00" class="w-full bg-[#EFECE6] border border-[#E2DDD5] rounded-[10px] p-3 pl-8 text-[#1A1614] placeholder-[#ADA69E] focus:outline-none focus:border-[#D97706] focus:ring-2 focus:ring-[#FDE68A] transition-all")

          //- Tiempo de inactividad
          div
            label(for="tiempo_inactividad_minutos" class="block text-[#1A1614] mb-2 text-sm font-medium") Tiempo de inactividad
            select(id="tiempo_inactividad_minutos" name="tiempo_inactividad_minutos" class="w-full bg-[#EFECE6] border border-[#E2DDD5] rounded-[10px] p-3 text-[#1A1614] focus:outline-none focus:border-[#D97706] focus:ring-2 focus:ring-[#FDE68A] transition-all")
              option(value="3") 3 minutos
              option(value="5" selected) 5 minutos
              option(value="10") 10 minutos
              option(value="15") 15 minutos
              option(value="30") 30 minutos
            p(class="text-[#ADA69E] text-xs mt-1") La subasta cierra si no recibe pujas en este tiempo.

        //- Programación: Inicio y Duración
        div(class="grid grid-cols-1 md:grid-cols-2 gap-6")

          //- Inicio de la subasta (después de aprobación)
          div
            label(for="inicio_delay_minutos" class="block text-[#1A1614] mb-2 text-sm font-medium") Inicio de la subasta
            select(id="inicio_delay_minutos" name="inicio_delay_minutos" class="w-full bg-[#EFECE6] border border-[#E2DDD5] rounded-[10px] p-3 text-[#1A1614] focus:outline-none focus:border-[#D97706] focus:ring-2 focus:ring-[#FDE68A] transition-all")
              option(value="0" selected) Inmediata (al aprobar)
              option(value="10") En 10 minutos
              option(value="30") En 30 minutos
              option(value="60") En 1 hora
              option(value="180") En 3 horas
              option(value="1440") Día siguiente (24h)
            p(class="text-[#ADA69E] text-xs mt-1") Tiempo desde que se aprueba hasta que inicia.

          //- Duración de la subasta
          div
            label(for="duracion_horas" class="block text-[#1A1614] mb-2 text-sm font-medium") Duración de la subasta
            select(id="duracion_horas" name="duracion_horas" class="w-full bg-[#EFECE6] border border-[#E2DDD5] rounded-[10px] p-3 text-[#1A1614] focus:outline-none focus:border-[#D97706] focus:ring-2 focus:ring-[#FDE68A] transition-all")
              option(value="1") 1 hora
              option(value="3") 3 horas
              option(value="6") 6 horas
              option(value="12") 12 horas
              option(value="24" selected) 24 horas
            p(class="text-[#ADA69E] text-xs mt-1") Tiempo máximo que la subasta estará activa.

        //- Categoría
        div
          label(for="categoria_id" class="block text-[#1A1614] mb-2 text-sm font-medium") Categoría
          select(id="categoria_id" name="categoria_id" required class="w-full bg-[#EFECE6] border border-[#E2DDD5] rounded-[10px] p-3 text-[#1A1614] focus:outline-none focus:border-[#D97706] focus:ring-2 focus:ring-[#FDE68A] transition-all")
            option(value="" disabled selected) Selecciona una categoría
            if categorias && categorias.length > 0
              each cat in categorias
                option(value=cat.id)= cat.nombre
            else
              option(value="" disabled) No hay categorías disponibles

        //- Fotos de la subasta (Portada + Galería hasta 5 fotos total)
        div(class="space-y-4")
          div(class="flex items-center justify-between")
            label(class="block text-[#1A1614] text-sm font-semibold") Fotos del artículo (máximo 5)
            span(id="contador-fotos" class="text-xs text-[#8A7F76] font-medium") 0 / 5 fotos agregadas

          //- Grid de fotos subidas con vista previa y botón eliminar individual
          div(id="grid-fotos" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3")
            //- Las miniaturas se renderizan dinámicamente con JS aquí

          //- Botón "+ Agregar foto" (visible si fotos < 5)
          div(id="contenedor-btn-agregar" class="pt-1")
            input(type="file" id="input-archivo-foto" accept="image/jpeg,image/png,image/gif,image/webp" multiple class="hidden")
            button(
              type="button"
              id="btn-agregar-foto"
              class="w-full sm:w-auto flex items-center justify-center gap-2 bg-[#EFECE6] hover:bg-[#E2DDD5] text-[#1A1614] border border-[#E2DDD5] hover:border-[#ADA69E] px-5 py-3 rounded-[12px] text-xs font-semibold transition-all shadow-sm group"
            )
              svg(class="w-4.5 h-4.5 text-[#D97706] group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2")
                path(stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4")
              span(id="texto-btn-agregar") + Subir fotos desde tu equipo (máximo 5)

          //- Opción secundaria opcional: URL directa de imagen web
          div(class="pt-1")
            details(class="text-xs text-[#8A7F76]")
              summary(class="hover:text-[#D97706] font-medium transition-colors cursor-pointer select-none") ¿Prefieres ingresar un enlace o URL de imagen web?
              div(class="mt-2 pt-2")
                input(type="url" id="imagen_url" name="imagen_url" placeholder="https://ejemplo.com/imagen.jpg" class="w-full bg-[#EFECE6] border border-[#E2DDD5] rounded-[10px] p-2.5 text-xs text-[#1A1614] placeholder-[#ADA69E] focus:outline-none focus:border-[#D97706] transition-all")

        //- Nota informativa
        div(class="bg-[#FFFBEB] border border-[#FDE68A] rounded-xl p-4")
          div(class="flex items-start gap-3")
            svg(class="w-5 h-5 text-[#D97706] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z")
            div
              p(class="text-[#92400E] text-sm font-semibold") Tu subasta será revisada antes de publicarse
              p(class="text-[#8A7F76] text-xs mt-1") Un administrador revisará tu publicación. La primera foto será la portada de la subasta.

        //- Botón submit
        div(class="flex justify-end gap-4")
          a(href="/subastas" class="px-6 py-3 rounded-[10px] text-[#8A7F76] hover:text-[#1A1614] border border-[#E2DDD5] hover:border-[#ADA69E] transition-colors font-medium text-sm") Cancelar
          button(type="submit" id="btn-publicar" class="bg-[#D97706] hover:bg-[#B45309] text-white font-bold px-8 py-3 rounded-[10px] transition-colors shadow-btn text-sm") Publicar Subasta

block scripts
  script.
    const form = document.getElementById('form-crear-subasta');
    const alertaError = document.getElementById('alerta-error');
    const mensajeError = document.getElementById('mensaje-error');
    const alertaExito = document.getElementById('alerta-exito');
    const btnPublicar = document.getElementById('btn-publicar');

    // Gestor interactivo de fotos (máximo 5)
    let listaArchivosFotos = [];
    const inputArchivo = document.getElementById('input-archivo-foto');
    const btnAgregarFoto = document.getElementById('btn-agregar-foto');
    const textoBtnAgregar = document.getElementById('texto-btn-agregar');
    const gridFotos = document.getElementById('grid-fotos');
    const contadorFotos = document.getElementById('contador-fotos');
    const contenedorBtnAgregar = document.getElementById('contenedor-btn-agregar');

    btnAgregarFoto.addEventListener('click', () => {
      inputArchivo.click();
    });

    inputArchivo.addEventListener('change', (e) => {
      const seleccionados = Array.from(e.target.files);
      if (seleccionados.length === 0) return;

      // Calcular cuántas fotos más caben hasta el máximo de 5
      const disponibles = 5 - listaArchivosFotos.length;
      const fotosAñadir = seleccionados.slice(0, disponibles);

      listaArchivosFotos.push(...fotosAñadir);
      inputArchivo.value = ''; // Limpiar input para permitir seleccionar de nuevo
      renderizarFotos();
    });

    function renderizarFotos() {
      gridFotos.innerHTML = '';
      contadorFotos.textContent = `${listaArchivosFotos.length} / 5 fotos agregadas`;

      if (listaArchivosFotos.length === 0) {
        textoBtnAgregar.textContent = '+ Subir fotos desde tu equipo (máximo 5)';
        contenedorBtnAgregar.classList.remove('hidden');
      } else if (listaArchivosFotos.length < 5) {
        const restantes = 5 - listaArchivosFotos.length;
        textoBtnAgregar.textContent = `+ ¿Deseas agregar otra foto? (${restantes} disponible${restantes > 1 ? 's' : ''})`;
        contenedorBtnAgregar.classList.remove('hidden');
      } else {
        contenedorBtnAgregar.classList.add('hidden');
      }

      listaArchivosFotos.forEach((file, index) => {
        const card = document.createElement('div');
        card.className = 'relative group bg-white border border-[#E2DDD5] rounded-xl overflow-hidden shadow-sm flex flex-col items-center';

        const reader = new FileReader();
        reader.onload = (ev) => {
          card.innerHTML = `
            <div class="relative w-full h-24 bg-[#EFECE6] overflow-hidden">
              <img src="${ev.target.result}" alt="${file.name}" class="w-full h-full object-cover">
              ${index === 0 ? '<span class="absolute top-1 left-1 bg-[#D97706] text-white text-[9px] font-bold px-1.5 py-0.5 rounded shadow-sm">PORTADA</span>' : ''}
              <button
                type="button"
                data-index="${index}"
                class="btn-quitar-foto absolute top-1 right-1 bg-white/90 hover:bg-[#FEF2F2] text-[#DC2626] border border-[#FECACA] rounded-full p-1 shadow-sm transition-all flex items-center justify-center"
                title="Quitar esta foto"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
              </button>
            </div>
            <div class="p-1.5 w-full text-center bg-white">
              <p class="text-[10px] text-[#3D3530] font-medium truncate">${file.name}</p>
            </div>
          `;

          // Handler para eliminar una foto específica
          const btnQuitar = card.querySelector('.btn-quitar-foto');
          btnQuitar.addEventListener('click', (e) => {
            e.stopPropagation();
            listaArchivosFotos.splice(index, 1);
            renderizarFotos();
          });
        };
        reader.readAsDataURL(file);

        gridFotos.appendChild(card);
      });
    }

    renderizarFotos();

    // Enviar formulario
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      alertaError.classList.add('hidden');
      alertaExito.classList.add('hidden');

      const titulo = document.getElementById('titulo').value.trim();
      const descripcion = document.getElementById('descripcion').value.trim();
      const precio_inicial = document.getElementById('precio_inicial').value;
      const categoria_id = document.getElementById('categoria_id').value;

      if (!titulo || !descripcion || !precio_inicial || !categoria_id) {
        mensajeError.textContent = 'Todos los campos obligatorios deben estar completos.';
        alertaError.classList.remove('hidden');
        return;
      }

      btnPublicar.disabled = true;
      btnPublicar.textContent = 'Publicando...';

      try {
        const token = localStorage.getItem('token');
        const formData = new FormData(form);

        // Adjuntar las fotos de la lista gestionada
        formData.delete('imagen');
        formData.delete('imagenes_extra');

        if (listaArchivosFotos.length > 0) {
          // La primera foto es la portada
          formData.append('imagen', listaArchivosFotos[0]);
          // Las fotos restantes son de la galería
          for (let i = 1; i < listaArchivosFotos.length; i++) {
            formData.append('imagenes_extra', listaArchivosFotos[i]);
          }
        }

        const respuesta = await fetch('/api/subastas', {
          method: 'POST',
          headers: {
            ...(token ? { Authorization: 'Bearer ' + token } : {})
          },
          credentials: 'include',
          body: formData
        });

        const datos = await respuesta.json();

        if (datos.exito) {
          alertaExito.classList.remove('hidden');
          form.reset();
          listaArchivosFotos = [];
          renderizarFotos();
          setTimeout(() => {
            window.location.href = '/subastas';
          }, 2000);
        } else {
          mensajeError.textContent = datos.mensaje || 'Error al publicar la subasta.';
          alertaError.classList.remove('hidden');
          btnPublicar.disabled = false;
          btnPublicar.textContent = 'Publicar Subasta';
        }
      } catch (err) {
        mensajeError.textContent = 'Error de conexión con el servidor.';
        alertaError.classList.remove('hidden');
        btnPublicar.disabled = false;
        btnPublicar.textContent = 'Publicar Subasta';
      }
    });
