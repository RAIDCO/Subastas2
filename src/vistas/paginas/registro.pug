//- Formulario de registro de nuevo usuario con verificación Gmail OTP en 2 pasos
doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= titulo || 'Registro - SubastasPro'

    //- Google Fonts: Inter
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet")

    script(src="https://cdn.tailwindcss.com")
    script.
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              sans: ['"Inter"', 'system-ui', 'sans-serif'],
            }
          }
        }
      }

    style.
      @keyframes fadeSlideUp {
        0% { opacity: 0; transform: translateY(16px); }
        100% { opacity: 1; transform: translateY(0); }
      }
      .anim-fade-up { animation: fadeSlideUp 0.5s ease-out both; }

  body(class="bg-[#F7F4EF] flex items-center justify-center min-h-screen font-sans antialiased py-10")

    div(class="w-full max-w-md bg-white border border-[#E2DDD5] rounded-[16px] shadow-lg p-8 anim-fade-up")

      //- Logo
      div(class="flex justify-center mb-6")
        a(href="/" class="flex items-center gap-2")
          div(class="w-9 h-9 rounded-lg bg-[#D97706] flex items-center justify-center")
            svg(class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2")
              path(stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z")
          span(class="font-bold text-xl text-[#1A1614]") SubastasPro

      h1(class="text-2xl font-bold text-center text-[#1A1614] mb-1") Crear una Cuenta
      p(id="subtitulo-registro" class="text-center text-[#8A7F76] mb-6 text-sm") Regístrate gratis y empieza a pujar.

      //- Alerta de error
      div(id="alerta-error" class="hidden mb-6 bg-[#FEF2F2] border border-[#FECACA] text-[#991B1B] text-sm p-4 rounded-xl flex items-center gap-2")
        svg(class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24")
          path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z")
        span(id="mensaje-error")

      //- Alerta de información
      div(id="alerta-info" class="hidden mb-6 bg-[#FFFBEB] border border-[#FDE68A] text-[#D97706] text-sm p-4 rounded-xl flex items-center gap-2")
        svg(class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24")
          path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z")
        span(id="mensaje-info")

      //- Alerta de éxito
      div(id="alerta-exito" class="hidden mb-6 bg-[#ECFDF5] border border-[#A7F3D0] text-[#065F46] text-sm p-4 rounded-xl flex items-center gap-2")
        svg(class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24")
          path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7")
        span ¡Cuenta creada correctamente! Redirigiendo al inicio de sesión...

      //- Formulario Paso 1: Datos de Registro
      form(id="form-paso-1" class="space-y-5" novalidate)

        div
          label(class="block text-[#1A1614] mb-2 text-sm font-medium") Nombre completo
          input(type="text" id="nombre" name="nombre" placeholder="María González" required class="w-full bg-[#EFECE6] border border-[#E2DDD5] rounded-[10px] p-3 text-[#1A1614] placeholder-[#ADA69E] focus:outline-none focus:border-[#D97706] focus:ring-2 focus:ring-[#FDE68A] transition-all")
          span(id="error-nombre" class="hidden text-[#DC2626] text-xs mt-1 block")

        div
          label(class="block text-[#1A1614] mb-2 text-sm font-medium") Correo electrónico (Gmail)
          input(type="email" id="correo" name="correo" placeholder="tu@gmail.com" required class="w-full bg-[#EFECE6] border border-[#E2DDD5] rounded-[10px] p-3 text-[#1A1614] placeholder-[#ADA69E] focus:outline-none focus:border-[#D97706] focus:ring-2 focus:ring-[#FDE68A] transition-all")
          span(id="error-correo" class="hidden text-[#DC2626] text-xs mt-1 block")

        div
          label(class="block text-[#1A1614] mb-2 text-sm font-medium") Contraseña
          input(type="password" id="clave" name="clave" placeholder="••••••••" required class="w-full bg-[#EFECE6] border border-[#E2DDD5] rounded-[10px] p-3 text-[#1A1614] placeholder-[#ADA69E] focus:outline-none focus:border-[#D97706] focus:ring-2 focus:ring-[#FDE68A] transition-all")
          span(id="error-clave" class="hidden text-[#DC2626] text-xs mt-1 block")

        div
          label(class="block text-[#1A1614] mb-2 text-sm font-medium") Confirmar contraseña
          input(type="password" id="confirmarClave" name="confirmarClave" placeholder="••••••••" required class="w-full bg-[#EFECE6] border border-[#E2DDD5] rounded-[10px] p-3 text-[#1A1614] placeholder-[#ADA69E] focus:outline-none focus:border-[#D97706] focus:ring-2 focus:ring-[#FDE68A] transition-all")
          span(id="error-confirmarClave" class="hidden text-[#DC2626] text-xs mt-1 block")

        div
          div(class="flex items-center gap-2 text-[#8A7F76] text-xs cursor-pointer")
            input(type="checkbox" required id="check-terminos" class="rounded border-[#E2DDD5] bg-[#EFECE6] text-[#D97706] focus:ring-[#FDE68A]")
            label(for="check-terminos" class="cursor-pointer")
              | Acepto los
              button(type="button" id="btn-abrir-terminos" class="text-[#D97706] hover:underline font-medium ml-1 inline-block") términos y condiciones
          span(id="error-terminos" class="hidden text-[#DC2626] text-xs mt-1 block")

        button(type="submit" id="btn-solicitar-codigo" class="w-full bg-[#D97706] hover:bg-[#B45309] text-white font-semibold py-3 rounded-[10px] transition-colors shadow-btn")
          | Enviar Código a mi Gmail

      //- Formulario Paso 2: Verificación de Código OTP (Oculto inicialmente)
      form(id="form-paso-2" class="hidden space-y-5")

        div(class="text-center")
          label(class="block text-[#1A1614] mb-2 text-sm font-medium") Código de verificación (6 dígitos)
          input(type="text" id="codigo" name="codigo" placeholder="123456" maxlength="6" pattern="[0-9]{6}" inputmode="numeric" required class="w-full bg-[#EFECE6] border border-[#E2DDD5] rounded-[10px] p-4 text-center font-mono text-2xl tracking-[0.4em] text-[#D97706] placeholder-[#ADA69E] focus:outline-none focus:border-[#D97706] focus:ring-2 focus:ring-[#FDE68A] transition-all")

        button(type="submit" id="btn-verificar" class="w-full bg-[#D97706] hover:bg-[#B45309] text-white font-semibold py-3 rounded-[10px] transition-colors shadow-btn")
          | Verificar y Crear Cuenta

        div(class="flex items-center justify-between text-xs text-[#8A7F76] pt-2")
          button(type="button" id="btn-volver" class="hover:text-[#1A1614] transition-colors")
            | ← Modificar correo
          button(type="button" id="btn-reenviar" disabled class="disabled:opacity-50 hover:text-[#D97706] transition-colors text-[#D97706] font-medium")
            | Reenviar código (<span id="contador-reenvio">60</span>s)

      p(class="text-center text-[#8A7F76] text-sm mt-6")
        | ¿Ya tienes cuenta?
        a(href="/iniciar-sesion" class="text-[#D97706] ml-1 hover:underline font-medium") Inicia sesión

    //- MODAL TÉRMINOS Y CONDICIONES
    div(id="modal-terminos" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-4")
      div(class="w-full max-w-lg bg-white border border-[#E2DDD5] rounded-[16px] shadow-2xl p-6 relative max-h-[85vh] flex flex-col anim-fade-up")

        div(class="flex items-center justify-between border-b border-[#EBE5DC] pb-4 mb-4")
          h2(class="text-lg font-bold text-[#1A1614]") Términos y Condiciones de Uso
          button(type="button" id="btn-cerrar-terminos" class="text-[#8A7F76] hover:text-[#1A1614] transition-colors p-1")
            svg(class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12")

        div(class="flex-1 overflow-y-auto space-y-4 pr-1 text-xs text-[#3D3530] leading-relaxed")
          div
            h3(class="font-bold text-[#1A1614] text-sm mb-1") 1. Registro y Verificación de Cuenta
            p Al registrarte en SubastasPro, declaras que los datos proporcionados son verídicos. Para garantizar la seguridad de la comunidad, exigimos la verificación mediante correo Gmail auténtico.

          div
            h3(class="font-bold text-[#1A1614] text-sm mb-1") 2. Pujas y Compromiso de Compra
            p Toda puja realizada en una subasta activa es firme y vinculante. Si tu puja resulta ganadora al cierre de la subasta, asumes la responsabilidad legal de adquirir el artículo al precio final registrado.

          div
            h3(class="font-bold text-[#1A1614] text-sm mb-1") 3. Publicaciones y Moderación
            p Las subastas publicadas por los usuarios están sujetas a revisión previa por administradores antes de ser visibles en el catálogo. Queda prohibida la publicación de artículos ilícitos o con imágenes engañosas.

          div
            h3(class="font-bold text-[#1A1614] text-sm mb-1") 4. Juego Limpio y Prohibición de Manipulación
            p Se prohíbe terminantemente la creación de cuentas múltiples o el uso de auto-pujas fraudulentas para elevar artificialmente el precio de una subasta propia. Las cuentas que incurran en estas prácticas serán suspendidas permanentemente.

        div(class="border-t border-[#EBE5DC] pt-4 mt-4 flex justify-end")
          button(type="button" id="btn-aceptar-terminos-modal" class="bg-[#D97706] hover:bg-[#B45309] text-white font-semibold text-xs px-5 py-2.5 rounded-[10px] transition-colors shadow-btn") Entendido y Aceptar

    script.
      const formPaso1 = document.getElementById('form-paso-1');
      const formPaso2 = document.getElementById('form-paso-2');
      const subtitulo = document.getElementById('subtitulo-registro');
      const alertaError = document.getElementById('alerta-error');
      const mensajeError = document.getElementById('mensaje-error');
      const alertaInfo = document.getElementById('alerta-info');
      const mensajeInfo = document.getElementById('mensaje-info');
      const alertaExito = document.getElementById('alerta-exito');

      const btnSolicitarCodigo = document.getElementById('btn-solicitar-codigo');
      const btnVerificar = document.getElementById('btn-verificar');
      const btnVolver = document.getElementById('btn-volver');
      const btnReenviar = document.getElementById('btn-reenviar');
      const contadorReenvioSpan = document.getElementById('contador-reenvio');

      // Modal Términos y Condiciones
      const modalTerminos = document.getElementById('modal-terminos');
      const btnAbrirTerminos = document.getElementById('btn-abrir-terminos');
      const btnCerrarTerminos = document.getElementById('btn-cerrar-terminos');
      const btnAceptarTerminosModal = document.getElementById('btn-aceptar-terminos-modal');
      const checkTerminos = document.getElementById('check-terminos');

      if (btnAbrirTerminos && modalTerminos) {
        btnAbrirTerminos.addEventListener('click', (e) => {
          e.preventDefault();
          modalTerminos.classList.remove('hidden');
        });
        btnCerrarTerminos.addEventListener('click', () => {
          modalTerminos.classList.add('hidden');
        });
        btnAceptarTerminosModal.addEventListener('click', () => {
          modalTerminos.classList.add('hidden');
          if (checkTerminos) {
            checkTerminos.checked = true;
            limpiarErrorCampo('check-terminos', 'error-terminos');
          }
        });
        modalTerminos.addEventListener('click', (e) => {
          if (e.target === modalTerminos) modalTerminos.classList.add('hidden');
        });
      }

      let contadorSegundos = 60;
      let intervaloContador = null;

      function ocultarAlertas() {
        alertaError.classList.add('hidden');
        alertaInfo.classList.add('hidden');
        alertaExito.classList.add('hidden');
      }

      function mostrarError(msg) {
        ocultarAlertas();
        mensajeError.textContent = msg;
        alertaError.classList.remove('hidden');
      }

      function mostrarInfo(msg) {
        ocultarAlertas();
        mensajeInfo.textContent = msg;
        alertaInfo.classList.remove('hidden');
      }

      // ── Utilidades de validación inline ──
      function mostrarErrorCampo(inputId, errorId, mensaje) {
        const input = document.getElementById(inputId);
        const errorSpan = document.getElementById(errorId);
        if (input) {
          input.classList.add('border-[#DC2626]');
          input.classList.remove('border-[#E2DDD5]');
        }
        if (errorSpan) {
          errorSpan.textContent = mensaje;
          errorSpan.classList.remove('hidden');
        }
      }

      function limpiarErrorCampo(inputId, errorId) {
        const input = document.getElementById(inputId);
        const errorSpan = document.getElementById(errorId);
        if (input) {
          input.classList.remove('border-[#DC2626]');
          input.classList.add('border-[#E2DDD5]');
        }
        if (errorSpan) {
          errorSpan.textContent = '';
          errorSpan.classList.add('hidden');
        }
      }

      function esCorreoValido(correo) {
        return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(correo);
      }

      function validarNombre() {
        const valor = document.getElementById('nombre').value.trim();
        if (!valor) {
          mostrarErrorCampo('nombre', 'error-nombre', 'El nombre es obligatorio.');
          return false;
        }
        if (valor.length < 3) {
          mostrarErrorCampo('nombre', 'error-nombre', 'El nombre debe tener al menos 3 caracteres. Actualmente tiene ' + valor.length + '.');
          return false;
        }
        limpiarErrorCampo('nombre', 'error-nombre');
        return true;
      }

      function validarCorreo() {
        const valor = document.getElementById('correo').value.trim().toLowerCase();
        if (!valor) {
          mostrarErrorCampo('correo', 'error-correo', 'El correo electrónico es obligatorio.');
          return false;
        }
        if (!esCorreoValido(valor)) {
          mostrarErrorCampo('correo', 'error-correo', 'Ingresa un correo electrónico válido (ej: usuario@gmail.com).');
          return false;
        }
        if (!valor.endsWith('@gmail.com') && !valor.endsWith('@googlemail.com')) {
          mostrarErrorCampo('correo', 'error-correo', 'Solo se aceptan correos de Gmail (@gmail.com).');
          return false;
        }
        limpiarErrorCampo('correo', 'error-correo');
        return true;
      }

      function validarClave() {
        const valor = document.getElementById('clave').value;
        if (!valor) {
          mostrarErrorCampo('clave', 'error-clave', 'La contraseña es obligatoria.');
          return false;
        }
        if (valor.length < 8) {
          mostrarErrorCampo('clave', 'error-clave', 'La contraseña debe tener al menos 8 caracteres. Actualmente tiene ' + valor.length + '.');
          return false;
        }
        limpiarErrorCampo('clave', 'error-clave');
        // Re-validar confirmación si ya tiene valor
        const confirmar = document.getElementById('confirmarClave').value;
        if (confirmar) validarConfirmarClave();
        return true;
      }

      function validarConfirmarClave() {
        const clave = document.getElementById('clave').value;
        const confirmar = document.getElementById('confirmarClave').value;
        if (!confirmar) {
          mostrarErrorCampo('confirmarClave', 'error-confirmarClave', 'Debes confirmar tu contraseña.');
          return false;
        }
        if (clave !== confirmar) {
          mostrarErrorCampo('confirmarClave', 'error-confirmarClave', 'Las contraseñas no coinciden.');
          return false;
        }
        limpiarErrorCampo('confirmarClave', 'error-confirmarClave');
        return true;
      }

      function validarTerminos() {
        const check = document.getElementById('check-terminos');
        if (!check || !check.checked) {
          mostrarErrorCampo('check-terminos', 'error-terminos', 'Debes aceptar los términos y condiciones.');
          return false;
        }
        limpiarErrorCampo('check-terminos', 'error-terminos');
        return true;
      }

      function validarFormularioPaso1() {
        const resultados = [
          validarNombre(),
          validarCorreo(),
          validarClave(),
          validarConfirmarClave(),
          validarTerminos()
        ];
        return resultados.every(r => r === true);
      }

      // Blur validation — real-time feedback
      document.getElementById('nombre').addEventListener('blur', validarNombre);
      document.getElementById('correo').addEventListener('blur', validarCorreo);
      document.getElementById('clave').addEventListener('blur', validarClave);
      document.getElementById('confirmarClave').addEventListener('blur', validarConfirmarClave);
      document.getElementById('check-terminos').addEventListener('change', validarTerminos);

      function iniciarContadorReenvio() {
        contadorSegundos = 60;
        btnReenviar.disabled = true;
        contadorReenvioSpan.textContent = contadorSegundos;
        if (intervaloContador) clearInterval(intervaloContador);

        intervaloContador = setInterval(() => {
          contadorSegundos--;
          contadorReenvioSpan.textContent = contadorSegundos;
          if (contadorSegundos <= 0) {
            clearInterval(intervaloContador);
            btnReenviar.disabled = false;
            btnReenviar.innerHTML = 'Reenviar código';
          }
        }, 1000);
      }

      // Paso 1: Solicitar código de verificación
      formPaso1.addEventListener('submit', async (e) => {
        e.preventDefault();
        ocultarAlertas();

        if (!validarFormularioPaso1()) {
          mostrarError('Por favor corrige los errores señalados en el formulario.');
          return;
        }

        const nombre = document.getElementById('nombre').value.trim();
        const correo = document.getElementById('correo').value.trim().toLowerCase();

        btnSolicitarCodigo.disabled = true;
        btnSolicitarCodigo.textContent = 'Enviando código...';

        try {
          const respuesta = await fetch('/api/autenticacion/solicitar-codigo', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ correo })
          });

          const datos = await respuesta.json();

          if (datos.exito) {
            formPaso1.classList.add('hidden');
            formPaso2.classList.remove('hidden');
            subtitulo.textContent = 'Verifica tu dirección de correo Gmail.';
            mostrarInfo(`Ingresa el código de 6 dígitos que enviamos a ${correo}.`);
            iniciarContadorReenvio();
            document.getElementById('codigo').focus();
          } else {
            mostrarError(datos.mensaje || 'Error al solicitar el código.');
          }
        } catch (err) {
          mostrarError('Error de conexión con el servidor.');
        } finally {
          btnSolicitarCodigo.disabled = false;
          btnSolicitarCodigo.textContent = 'Enviar Código a mi Gmail';
        }
      });

      // Botón volver al Paso 1
      btnVolver.addEventListener('click', () => {
        ocultarAlertas();
        formPaso2.classList.add('hidden');
        formPaso1.classList.remove('hidden');
        subtitulo.textContent = 'Regístrate gratis y empieza a pujar.';
      });

      // Reenviar código
      btnReenviar.addEventListener('click', async () => {
        const correo = document.getElementById('correo').value.trim().toLowerCase();
        btnReenviar.disabled = true;

        try {
          const respuesta = await fetch('/api/autenticacion/solicitar-codigo', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ correo })
          });

          const datos = await respuesta.json();

          if (datos.exito) {
            mostrarInfo(`Nuevo código enviado a ${correo}.`);
            iniciarContadorReenvio();
          } else {
            mostrarError(datos.mensaje || 'Error al reenviar el código.');
            btnReenviar.disabled = false;
          }
        } catch (err) {
          mostrarError('Error de conexión con el servidor.');
          btnReenviar.disabled = false;
        }
      });

      // Paso 2: Enviar código y registrar cuenta
      formPaso2.addEventListener('submit', async (e) => {
        e.preventDefault();
        ocultarAlertas();

        const nombre = document.getElementById('nombre').value.trim();
        const correo = document.getElementById('correo').value.trim().toLowerCase();
        const clave = document.getElementById('clave').value;
        const codigo = document.getElementById('codigo').value.trim();

        if (codigo.length !== 6 || !/^\d{6}$/.test(codigo)) {
          mostrarError('El código debe tener exactamente 6 dígitos numéricos.');
          return;
        }

        btnVerificar.disabled = true;
        btnVerificar.textContent = 'Verificando y creando cuenta...';

        try {
          const respuesta = await fetch('/api/autenticacion/registro', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ nombre, correo, clave, codigo })
          });

          const datos = await respuesta.json();

          if (datos.exito) {
            ocultarAlertas();
            alertaExito.classList.remove('hidden');
            formPaso2.reset();
            setTimeout(() => {
              window.location.href = '/iniciar-sesion';
            }, 1500);
          } else {
            mostrarError(datos.mensaje || 'Error al verificar la cuenta.');
            btnVerificar.disabled = false;
            btnVerificar.textContent = 'Verificar y Crear Cuenta';
          }
        } catch (err) {
          mostrarError('Error de conexión con el servidor.');
          btnVerificar.disabled = false;
          btnVerificar.textContent = 'Verificar y Crear Cuenta';
        }
      });